# clang-tidy configuration for the zenoh C++23 library.
#
# A high-signal, low-noise set: bug-prone patterns, performance, portability, and
# misc correctness. A few checks are disabled because they fight this codebase's
# deliberate idioms or produce false positives with C++23 modules / std::expected:
#   - bugprone-exception-escape: the ZTRY macro calls expected::value() only after
#     checking has_value(), so it never actually throws in these noexcept functions.
#   - portability-avoid-pragma-once: `#pragma once` is the project's chosen idiom.
#   - performance-move-const-arg: harmless no-op std::move on trivially-copyable
#     message structs is generated by the editor tooling; not worth churn.
#   - misc-include-cleaner / misc-const-correctness: noisy with named modules.
#   - misc-use-internal-linkage: false-positives on `export`ed inline functions in
#     module interface units — they ARE the cross-module public API, so they cannot
#     have internal linkage. (clang-tidy 19 flags them; newer versions don't.)
#   - bugprone-unused-return-value: the runtime intentionally `(void)`-discards the
#     result of best-effort I/O (e.g. flush in destructors); [[nodiscard]] already
#     enforces the non-discardable cases at compile time. (clang-tidy 19 ignores the
#     explicit cast-to-void that newer versions honor.)
#   - misc-header-include-cycle: vendored standalone Asio (third_party/asio, broker
#     only) deliberately splits each header into a `foo.hpp` declarations file and a
#     `impl/foo.ipp` bodies file that re-includes `foo.hpp` (guarded by the normal
#     include guard, so it's not an actual cycle) -- a standard header-only-library
#     idiom, not a bug in code this project owns.
#
# The list is anchored with a leading `-*` so the enabled set is exactly what is
# written here on every clang-tidy version. Without it the set is version-dependent:
# clang-tidy's built-in default is `clang-analyzer-*`, and clang-tidy 19 (what CI
# runs) *appends* a file-level `Checks` to that default, while a current clang-tidy
# (23) does not -- so the static analyzer ran on CI and nowhere else. It is
# deliberately off: its path-sensitive reports land *inside* vendored
# third_party/asio headers (uninitialized fields in Asio's any_executor/awaitable
# machinery) on paths that start in broker/src, and such a report cannot be
# suppressed -- clang-tidy keeps a header diagnostic whenever any note on the path
# refers to code we own, so neither HeaderFilterRegex, --exclude-header-filter, nor
# compiling Asio as a system include silences it.
Checks: >
  -*,
  bugprone-*,
  -bugprone-exception-escape,
  -bugprone-easily-swappable-parameters,
  -bugprone-unused-return-value,
  performance-*,
  -performance-move-const-arg,
  portability-*,
  -portability-avoid-pragma-once,
  misc-*,
  -misc-include-cleaner,
  -misc-const-correctness,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-use-internal-linkage,
  -misc-header-include-cycle
# Unanchored substring match, so scoped narrowly enough to avoid matching
# vendored third-party headers pulled in transitively (third_party/asio/asio/
# include/... would otherwise match a bare "include/" alternative -- our own
# public headers always sit under include/zenoh/, so that's what's matched
# instead of the bare directory name).
HeaderFilterRegex: '(src/|broker/|include/zenoh/)'
FormatStyle: file
CheckOptions:
  # A wire codec is bit twiddling against literal masks and shifts -- `h & 0x0f`,
  # `nibble << 4`. Those literals are `int`, so by default every one of them is a
  # signed operand and the check fires on the notation rather than on anything
  # dangerous (clang-tidy 23 reports ~45 such sites here; 19, which CI runs, reports
  # none of them). This is upstream's knob for exactly that: a *positive literal*
  # operand carries no sign surprise, while a signed variable, a signed
  # sub-expression, or a negative literal -- the sign-extension and
  # implementation-defined-shift bugs the check exists for -- is still reported.
  # Those the codec avoids in the code itself: `zenoh::flag_if` and `unsigned{...}`
  # keep header-byte assembly unsigned end to end instead of relying on promotion.
  - key: bugprone-signed-bitwise.IgnorePositiveIntegerLiterals
    value: true
